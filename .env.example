# Prefer Soan & duyet > Ket noi AIBox or connect_ai_mac.command.
# Copy to .env only if configuring manually. Never commit .env.
AIBOX_API_KEY=
TAVILY_API_KEY=
AIBOX_MODEL=deepseek-v4.1-flash
# Website AI uses only https://api.ai-box.vn/v1 (Chat Completions compatible).
# No custom base URL is loaded. Global Codex settings and quota stay separate.
# Saving API settings applies on the next app rerun; no restart required.
# Optional absolute path. Defaults to ~/Documents/FRIC_LAW_WeChat_Studio
# FRIC_WORKSPACE=/Users/yourname/Documents/FRIC_LAW_WeChat_Studio
